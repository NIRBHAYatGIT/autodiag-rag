# ──────────────────────────────────────────────────────────────
# AutoDiag-RAG  •  Environment Variables Example
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ──────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────
# Groq API key — https://console.groq.com/
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY

# ── Document Parsing (LlamaParse) ─────────────────────────────
# LlamaCloud API key — https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=llx_REPLACE_WITH_YOUR_LLAMA_KEY

# ── Vector Store ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=autodiag_manual

# ── Embedding Model ───────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LLM Settings ──────────────────────────────────────────────
LLM_MODEL=llama-3.1-8b-instant
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# ── Retrieval Settings ────────────────────────────────────────
RETRIEVER_TOP_K=10
BM25_TOP_K=10
RERANKER_TOP_N=4

# ── Chunking Settings ─────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Evaluation (RAGAS) ────────────────────────────────────────
OPENAI_API_KEY=sk_REPLACE_IF_USING_OPENAI_FOR_EVAL
